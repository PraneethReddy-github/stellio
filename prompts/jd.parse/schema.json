{
  "type": "object",
  "properties": {
    "title": {
      "type": ["string", "null"]
    },
    "company": {
      "type": ["string", "null"]
    },
    "location": {
      "type": "object",
      "properties": {
        "city": {
          "type": ["string", "null"]
        },
        "country": {
          "type": ["string", "null"]
        },
        "remote": {
          "type": "string",
          "enum": ["onsite", "hybrid", "remote", "unknown"]
        }
      },
      "required": ["city", "country", "remote"],
      "additionalProperties": false
    },
    "employment_type": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["full_time", "part_time", "contract", "internship", "temporary", "freelance"]
        },
        {
          "type": "null"
        }
      ]
    },
    "seniority": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["intern", "junior", "mid", "senior", "staff", "lead", "manager", "director", "executive"]
        },
        {
          "type": "null"
        }
      ]
    },
    "salary": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "min": {
              "type": ["number", "null"]
            },
            "max": {
              "type": ["number", "null"]
            },
            "currency": {
              "type": ["string", "null"]
            },
            "period": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": ["year", "month", "week", "day", "hour"]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["min", "max", "currency", "period"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "language": {
      "type": ["string", "null"]
    },
    "deadline": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["required", "preferred"]
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["text", "kind", "skills"],
        "additionalProperties": false
      }
    },
    "responsibilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "about": {
      "type": ["string", "null"]
    },
    "benefits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "company",
    "location",
    "employment_type",
    "seniority",
    "salary",
    "language",
    "deadline",
    "requirements",
    "responsibilities",
    "about",
    "benefits"
  ],
  "additionalProperties": false
}
