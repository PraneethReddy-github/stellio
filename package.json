{
  "name": "stellio",
  "productName": "Stellio",
  "version": "1.0.4",
  "private": true,
  "description": "Local-first career agent: job discovery, tailored LaTeX resumes, skill audit, application tracker.",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.e2e.json --noEmit && tsc -p tsconfig.unit-ui.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:e2e": "VITE_DEV_UI=1 electron-vite build",
    "e2e": "npm run build:e2e && playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "eval": "node tests/evals/cli.mjs",
    "dist": "npm run build && electron-builder --linux AppImage deb",
    "dist:e2e": "npm run build:e2e && electron-builder --linux --dir -c.directories.output=release-e2e -c.electronFuses.runAsNode=true -c.electronFuses.enableNodeOptionsEnvironmentVariable=true -c.electronFuses.enableNodeCliInspectArguments=true",
    "icons": "node scripts/make-icons.mjs",
    "perf": "npm run build && node tests/perf/run.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4",
    "linkedom": "0.18.15",
    "pdfjs-dist": "6.5.438",
    "turndown": "7.2.5",
    "ulid": "3.0.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@eslint/js": "10.0.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@playwright/test": "1.65.1",
    "@tanstack/react-query": "5.108.1",
    "@tanstack/react-router": "1.170.46",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "6.3.0",
    "cmdk": "1.1.1",
    "drizzle-kit": "0.31.11",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.3",
    "get-nonce": "1.0.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "lucide-react": "1.76.0",
    "prettier": "3.10.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "zustand": "5.1.0"
  },
  "author": "Praneeth Reddy",
  "homepage": "https://github.com/PraneethReddy-github/stellio",
  "desktopName": "stellio.desktop"
}
